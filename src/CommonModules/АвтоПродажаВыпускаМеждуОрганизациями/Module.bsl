// Цены по виду цен и суммы с НДС - типовыми механизмами ценообразования и обработки табличных частей.
Процедура ЗаполнитьЦеныИСуммы(ДокументОбъект, ВидЦены)

	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	ПараметрыПересчетаНДС = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);

	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ПараметрыЗаполненияСтавкиНДС(ДокументОбъект));
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(ДокументОбъект.Товары, СтруктураДействий, КэшированныеЗначения);

	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Дата",    ДокументОбъект.Дата);
	ПараметрыЗаполнения.Вставить("Валюта",  ДокументОбъект.Валюта);
	ПараметрыЗаполнения.Вставить("ВидЦены", ВидЦены);

	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСумму",     "КоличествоУпаковок");
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",  ПараметрыПересчетаНДС);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", ПараметрыПересчетаНДС);

	ЦенообразованиеСервер.ЗаполнитьЦены(ДокументОбъект.Товары, Неопределено, ПараметрыЗаполнения,
		СтруктураДействий, КэшированныеЗначения);

	ПроверитьЦеныИСтавкиНДС(ДокументОбъект, ВидЦены);

КонецПроцедуры

// ТОЧКА СВЕРКИ С РЕЛИЗОМ. Параметры действия "ЗаполнитьСтавкуНДС" менялись между релизами ERP 2.5
// (перечисление -> справочник СтавкиНДС). Вызов должен совпадать с тем, что используется в модуле формы
// документа РеализацияТоваровУслуг вашего релиза (поиск по строке "ЗаполнитьСтавкуНДС").
Функция ПараметрыЗаполненияСтавкиНДС(ДокументОбъект)

	Возврат ОбработкаТабличнойЧастиКлиентСервер.ПараметрыЗаполненияСтавкиНДС(ДокументОбъект);

КонецФункции

// Не допускаем появления реализации с нулевыми ценами или без ставки НДС: такие документы типовая
// проверка заполнения пропустит, а ошибка всплывет только в регламентированном учете.
Процедура ПроверитьЦеныИСтавкиНДС(ДокументОбъект, ВидЦены)

	ОблагаетсяНДС = (ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);

	Ошибки = Новый Массив;
	Для Каждого СтрокаТоваров Из ДокументОбъект.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Цена) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: не установлена цена ""%2"" на %3 для %4'"),
				СтрокаТоваров.НомерСтроки, ВидЦены, Формат(ДокументОбъект.Дата, "ДЛФ=D"),
				ПредставлениеНоменклатуры(СтрокаТоваров)));
		КонецЕсли;
		Если ОблагаетсяНДС И Не ЗначениеЗаполнено(СтрокаТоваров.СтавкаНДС) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: не определена ставка НДС для %2'"),
				СтрокаТоваров.НомерСтроки, ПредставлениеНоменклатуры(СтрокаТоваров)));
		КонецЕсли;
	КонецЦикла;

	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьСтатусыУказанияСерий(ДокументОбъект, МенеджерДокумента)

	ПараметрыУказанияСерий = МенеджерДокумента.ПараметрыУказанияСерий(ДокументОбъект);
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокументОбъект, ПараметрыУказанияСерий);

