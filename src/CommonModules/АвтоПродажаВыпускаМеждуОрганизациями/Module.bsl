// ТОЧКА СВЕРКИ С РЕЛИЗОМ: имена реквизитов табличной части ВыходныеИзделия (Получатель - склад или
// подразделение, куда выпущено изделие). Дата выпуска - дата документа: на нее формируются движения этапа.
Функция ВыпускЗаДень(НачалоДня, КонецДня, Настройки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВыходныеИзделия.Получатель КАК Справочник.Склады) КАК Склад,
	|	ВыходныеИзделия.Номенклатура КАК Номенклатура,
	|	ВыходныеИзделия.Характеристика КАК Характеристика,
	|	ВыходныеИзделия.Назначение КАК Назначение,
	|	ВыходныеИзделия.Серия КАК Серия,
	|	СУММА(ВыходныеИзделия.Количество) КАК Количество
	|ИЗ
	|	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ВыходныеИзделия
	|ГДЕ
	|	ВыходныеИзделия.Ссылка.Проведен
	|	И ВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Завершен)
	|	И ВыходныеИзделия.Ссылка.Организация = &Организация
	|	И ВыходныеИзделия.Ссылка.Дата МЕЖДУ &НачалоДня И &КонецДня
	|	И ВыходныеИзделия.Получатель ССЫЛКА Справочник.Склады
	|	И (&СкладОтгрузки = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|			ИЛИ ВыходныеИзделия.Получатель = &СкладОтгрузки)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыходныеИзделия.Получатель,
	|	ВыходныеИзделия.Номенклатура,
	|	ВыходныеИзделия.Характеристика,
	|	ВыходныеИзделия.Назначение,
	|	ВыходныеИзделия.Серия
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВыходныеИзделия.Количество) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	Номенклатура,
	|	Характеристика";

	Запрос.УстановитьПараметр("Организация",   Настройки.ОрганизацияПродавец);
	Запрос.УстановитьПараметр("НачалоДня",     НачалоДня);
	Запрос.УстановитьПараметр("КонецДня",      КонецДня);
	Запрос.УстановитьПараметр("СкладОтгрузки", Настройки.СкладОтгрузки);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает Соответствие: Склад -> ДокументСсылка.РеализацияТоваровУслуг, созданные этим модулем за день.
Функция РанееСозданныеРеализации(НачалоДня, КонецДня, Настройки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реализация.Ссылка КАК Ссылка,
	|	Реализация.Склад КАК Склад
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Дата МЕЖДУ &НачалоДня И &КонецДня
	|	И Реализация.Организация = &Организация
	|	И Реализация.Контрагент = &Контрагент
	|	И НЕ Реализация.ПометкаУдаления
	|	И ВЫРАЗИТЬ(Реализация.Комментарий КАК СТРОКА(100)) ПОДОБНО &Маркер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализация.Дата";

	Запрос.УстановитьПараметр("Организация", Настройки.ОрганизацияПродавец);
	Запрос.УстановитьПараметр("Контрагент",  Настройки.КонтрагентПокупатель);
	Запрос.УстановитьПараметр("НачалоДня",   НачалоДня);
	Запрос.УстановитьПараметр("КонецДня",    КонецДня);
	Запрос.УстановитьПараметр("Маркер",      МаркерДокумента() + "%");

	Реализации = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Реализации.Вставить(Выборка.Склад, Выборка.Ссылка);
	КонецЦикла;

	Возврат Реализации;

КонецФункции

Функция РанееСозданноеПриобретение(СсылкаРеализация, Организация)

	Приобретения = РанееСозданныеПриобретения(СсылкаРеализация, Организация);
	Возврат ?(Приобретения.Количество() = 0, Неопределено, Приобретения[0]);

КонецФункции

Функция РанееСозданныеПриобретения(СсылкаРеализация, Организация = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Приобретение.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Приобретение
	|ГДЕ
	|	НЕ Приобретение.ПометкаУдаления
	|	И (НЕ &ОтбиратьПоОрганизации ИЛИ Приобретение.Организация = &Организация)
	|	И ВЫРАЗИТЬ(Приобретение.Комментарий КАК СТРОКА(100)) ПОДОБНО &Маркер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приобретение.Дата";

	Запрос.УстановитьПараметр("ОтбиратьПоОрганизации", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Маркер", МаркерПриобретения(СсылкаРеализация) + "%");

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция СчетФактураПоОснованию(ИмяДокумента, Основание)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.#ИмяДокумента.ДокументыОснования КАК ДокументыОснования
	|ГДЕ
	|	ДокументыОснования.ДокументОснование = &Основание
	|	И НЕ ДокументыОснования.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументыОснования.Ссылка.Дата", "#ИмяДокумента", ИмяДокумента);

	Запрос.УстановитьПараметр("Основание", Основание);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

