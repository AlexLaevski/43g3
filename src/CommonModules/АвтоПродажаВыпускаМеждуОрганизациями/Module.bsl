///////////////////////////////////////////////////////////////////////////////////////////////////////
// Общий модуль АвтоПродажаВыпускаМеждуОрганизациями
// Свойства модуля: Сервер = Истина, ВызовСервера = Ложь, Привилегированный = Ложь.
//
// 1С:ERP Управление предприятием 2.5, БСП 3.1.
//
// По завершенным этапам производства (Документ.ЭтапПроизводства2_2) организации-продавца за день
// формирует и проводит цепочку документов:
//
//   организация-продавец:   РеализацияТоваровУслуг  -> СчетФактураВыданный
//   организация-покупатель: ПриобретениеТоваровУслуг -> СчетФактураПолученный
//
// Одна цепочка на каждый склад выпуска за день. Повторный запуск за тот же день перезаполняет
// и перепроводит ранее созданные документы (а не создает дубли), если выпуска по складу больше нет —
// помечает цепочку на удаление.
//
// Партионный учет (версия 2.2) ведется типовыми механизмами проведения: модуль не пишет движений сам,
// виды запасов заполняются типовым кодом при проведении, себестоимость реализации и стоимость партий
// у покупателя определяются типовым расчетом себестоимости при закрытии месяца.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает пустую структуру настроек обмена между организациями.
//
// Возвращаемое значение:
//  Структура:
//   * ОрганизацияПродавец    - СправочникСсылка.Организации - организация, выпустившая продукцию.
//   * ПартнерПокупатель      - СправочникСсылка.Партнеры - партнер в реализации.
//   * КонтрагентПокупатель   - СправочникСсылка.Контрагенты, СправочникСсылка.Организации - контрагент в реализации.
//   * СоглашениеСКлиентом    - СправочникСсылка.СоглашенияСКлиентами - необязательно.
//   * ДоговорСКлиентом       - СправочникСсылка.ДоговорыКонтрагентов - необязательно.
//   * ВидЦены                - СправочникСсылка.ВидыЦен - вид цены продажи.
//   * СкладОтгрузки          - СправочникСсылка.Склады - если заполнен, берется выпуск только на этот склад.
//   * ОрганизацияПокупатель  - СправочникСсылка.Организации
//   * ПартнерПоставщик       - СправочникСсылка.Партнеры - партнер в приобретении.
//   * КонтрагентПоставщик    - СправочникСсылка.Контрагенты, СправочникСсылка.Организации - контрагент в приобретении.
//   * СоглашениеСПоставщиком - СправочникСсылка.СоглашенияСПоставщиками - необязательно.
//   * ДоговорСПоставщиком    - СправочникСсылка.ДоговорыКонтрагентов - необязательно.
//   * СкладПоступления       - СправочникСсылка.Склады - склад покупателя.
//   * Проводить              - Булево - Истина: документы проводятся, Ложь: только записываются.
//
Функция НовыеНастройки() Экспорт

	Настройки = Новый Структура;

	Настройки.Вставить("ОрганизацияПродавец",    Справочники.Организации.ПустаяСсылка());
	Настройки.Вставить("ПартнерПокупатель",      Справочники.Партнеры.ПустаяСсылка());
	Настройки.Вставить("КонтрагентПокупатель",   Неопределено);
	Настройки.Вставить("СоглашениеСКлиентом",    Неопределено);
	Настройки.Вставить("ДоговорСКлиентом",       Неопределено);
	Настройки.Вставить("ВидЦены",                Справочники.ВидыЦен.ПустаяСсылка());
	Настройки.Вставить("СкладОтгрузки",          Справочники.Склады.ПустаяСсылка());

	Настройки.Вставить("ОрганизацияПокупатель",  Справочники.Организации.ПустаяСсылка());
	Настройки.Вставить("ПартнерПоставщик",       Справочники.Партнеры.ПустаяСсылка());
	Настройки.Вставить("КонтрагентПоставщик",    Неопределено);
	Настройки.Вставить("СоглашениеСПоставщиком", Неопределено);
	Настройки.Вставить("ДоговорСПоставщиком",    Неопределено);
	Настройки.Вставить("СкладПоступления",       Справочники.Склады.ПустаяСсылка());

	Настройки.Вставить("Проводить", Истина);

	Возврат Настройки;

КонецФункции

// Формирует цепочки документов по выпуску за день.
//
// Параметры:
//  ДатаВыпуска - Дата - любой момент дня выпуска.
//  Настройки   - см. НовыеНастройки.
//
// Возвращаемое значение:
//  Структура:
//   * Цепочки - Массив из Структура - Склад, Реализация, СчетФактураВыданный, Приобретение, СчетФактураПолученный.
//   * Ошибки  - Массив из Строка.
//
Функция СформироватьДокументыЗаДень(Знач ДатаВыпуска, Знач Настройки) Экспорт

	ПроверитьНастройки(Настройки);

	Результат = Новый Структура;
	Результат.Вставить("Цепочки", Новый Массив);
	Результат.Вставить("Ошибки",  Новый Массив);

	НачалоДня = НачалоДня(ДатаВыпуска);
	КонецДня  = КонецДня(ДатаВыпуска);

	Выпуск = ВыпускЗаДень(НачалоДня, КонецДня, Настройки);
	РанееСозданные = РанееСозданныеРеализации(НачалоДня, КонецДня, Настройки);

	Склады = Выпуск.Скопировать(, "Склад");
	Склады.Свернуть("Склад");

	Для Каждого СтрокаСклада Из Склады Цикл

		Склад = СтрокаСклада.Склад;
		СсылкаРеализация = РанееСозданные.Получить(Склад);
		РанееСозданные.Удалить(Склад);

		Попытка
			Цепочка = СформироватьЦепочку(КонецДня, Склад,
				Выпуск.НайтиСтроки(Новый Структура("Склад", Склад)), СсылкаРеализация, Настройки);
			Результат.Цепочки.Добавить(Цепочка);
		Исключение
			ЗарегистрироватьОшибку(Результат,
				СтрШаблон(НСтр("ru = 'Выпуск за %1, склад ""%2""'"), Формат(НачалоДня, "ДЛФ=D"), Склад),
				ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

	// Выпуска по складу больше нет (этап отменен/перенесен) - ранее созданная цепочка не нужна.
	Для Каждого КлючИЗначение Из РанееСозданные Цикл
		Попытка
			ПометитьЦепочкуНаУдаление(КлючИЗначение.Значение);
		Исключение
			ЗарегистрироватьОшибку(Результат,
				СтрШаблон(НСтр("ru = 'Пометка на удаление %1'"), КлючИЗначение.Значение),
				ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует документы по каждому дню периода (например, для перезаполнения за прошлые даты).
//
// Параметры:
//  НачалоПериода, КонецПериода - Дата
//  Настройки - см. НовыеНастройки.
//
// Возвращаемое значение:
//  Структура - см. СформироватьДокументыЗаДень, объединенная по всем дням.
//
Функция СформироватьДокументыЗаПериод(Знач НачалоПериода, Знач КонецПериода, Знач Настройки) Экспорт

	Итог = Новый Структура("Цепочки, Ошибки", Новый Массив, Новый Массив);

	День = НачалоДня(НачалоПериода);
	Пока День <= КонецПериода Цикл
		РезультатДня = СформироватьДокументыЗаДень(День, Настройки);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Итог.Цепочки, РезультатДня.Цепочки);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Итог.Ошибки,  РезультатДня.Ошибки);
		День = День + 86400;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Сохраняет наборы настроек для регламентного задания (одна организация-продавец - один набор).
//
// Параметры:
//  НаборыНастроек - Массив из см. НовыеНастройки
//
Процедура СохранитьНастройкиРегламентногоЗадания(НаборыНастроек) Экспорт

	Для Каждого Настройки Из НаборыНастроек Цикл
		ПроверитьНастройки(Настройки);
	КонецЦикла;

	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючНастроек(), "НаборыНастроек",
		НаборыНастроек, , ИмяПользователяНастроек());

КонецПроцедуры

// Возвращает наборы настроек регламентного задания.
//
// Возвращаемое значение:
//  Массив из см. НовыеНастройки
//
Функция НастройкиРегламентногоЗадания() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(КлючНастроек(), "НаборыНастроек",
		Новый Массив, , ИмяПользователяНастроек());

КонецФункции

// Обработчик регламентного задания: формирует документы за предыдущий день.
// Регламентное задание добавляется в расширение, имя метода:
//   АвтоПродажаВыпускаМеждуОрганизациями.ВыполнитьРегламентноеЗадание
//
Процедура ВыполнитьРегламентноеЗадание() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.АвтоПродажаВыпускаМеждуОрганизациями);

	ДатаВыпуска = НачалоДня(ТекущаяДатаСеанса()) - 1;

	Для Каждого Настройки Из НастройкиРегламентногоЗадания() Цикл
		Результат = СформироватьДокументыЗаДень(ДатаВыпуска, Настройки);
		Если Результат.Ошибки.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон(НСтр("ru = 'Выпуск за %1, %2: сформировано цепочек документов: %3'"),
					Формат(ДатаВыпуска, "ДЛФ=D"), Настройки.ОрганизацияПродавец, Результат.Цепочки.Количество()));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЦепочкаДокументов

Функция СформироватьЦепочку(ДатаДокументов, Склад, Товары, СсылкаРеализация, Настройки)

	Цепочка = Новый Структура("Склад, Реализация, СчетФактураВыданный, Приобретение, СчетФактураПолученный", Склад);

	НачатьТранзакцию();
	Попытка

		Если ЗначениеЗаполнено(СсылкаРеализация) Тогда
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.РеализацияТоваровУслуг");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаРеализация);
			Блокировка.Заблокировать();
		КонецЕсли;

		Реализация = ЗаполнитьРеализацию(СсылкаРеализация, ДатаДокументов, Склад, Товары, Настройки);
		ЗаписатьДокумент(Реализация, Настройки.Проводить);
		Цепочка.Реализация = Реализация.Ссылка;

		СчетФактураВыданный = ЗаполнитьСчетФактуру("СчетФактураВыданный", Реализация.Ссылка, Реализация.Дата);
		ЗаписатьДокумент(СчетФактураВыданный, Настройки.Проводить);
		Цепочка.СчетФактураВыданный = СчетФактураВыданный.Ссылка;

		Приобретение = ЗаполнитьПриобретение(Реализация, Настройки);
		ЗаписатьДокумент(Приобретение, Настройки.Проводить);
		Цепочка.Приобретение = Приобретение.Ссылка;

		СчетФактураПолученный = ЗаполнитьСчетФактуру("СчетФактураПолученный", Приобретение.Ссылка, Приобретение.Дата);
		// Входящий счет-фактура имеет номер и дату исходящего счета-фактуры продавца.
		СчетФактураПолученный.Номер = НомерНаПечать(СчетФактураВыданный.Номер);
		СчетФактураПолученный.Дата  = СчетФактураВыданный.Дата;
		УстановитьРеквизитЕслиЕсть(СчетФактураПолученный, "ДатаПолучения", СчетФактураВыданный.Дата);
		ЗаписатьДокумент(СчетФактураПолученный, Настройки.Проводить);
		Цепочка.СчетФактураПолученный = СчетФактураПолученный.Ссылка;

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Цепочка;

КонецФункции

Функция ЗаполнитьРеализацию(СсылкаРеализация, ДатаДокумента, Склад, Товары, Настройки)

	ДанныеЗаполнения = ДанныеЗаполненияРеализации(Склад, Настройки);

	Если ЗначениеЗаполнено(СсылкаРеализация) Тогда
		Реализация = СсылкаРеализация.ПолучитьОбъект();
	Иначе
		Реализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Реализация.Дата = ДатаДокумента;
		// Типовая обработка заполнения: валюта, налогообложение НДС, условия соглашения, менеджер и т.п.
		Реализация.Заполнить(ДанныеЗаполнения);
	КонецЕсли;

	// Заполнение по умолчанию/по статистике могло подставить другие значения - настройки приоритетнее.
	ЗаполнитьЗначенияСвойств(Реализация, ДанныеЗаполнения);
	Реализация.Дата = ДатаДокумента;
	Реализация.Комментарий = СтрШаблон(НСтр("ru = '%1 Выпуск продукции за %2'"),
		МаркерДокумента(), Формат(ДатаДокумента, "ДЛФ=D"));
	// При перезаполнении виды запасов (партии) должны заново определиться типовым кодом при проведении.
	УстановитьРеквизитЕслиЕсть(Реализация, "ВидыЗапасовУказаныВручную", Ложь);

	Реализация.Товары.Очистить();
	Для Каждого СтрокаВыпуска Из Товары Цикл
		СтрокаТоваров = Реализация.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаВыпуска, "Номенклатура, Характеристика, Назначение, Серия");
		СтрокаТоваров.КоличествоУпаковок = СтрокаВыпуска.Количество;
		СтрокаТоваров.Склад   = Склад;
		СтрокаТоваров.ВидЦены = Настройки.ВидЦены;
	КонецЦикла;

	ЗаполнитьЦеныИСуммы(Реализация, Настройки.ВидЦены);
	ЗаполнитьСтатусыУказанияСерий(Реализация, Документы.РеализацияТоваровУслуг);

	Возврат Реализация;

КонецФункции

Функция ЗаполнитьПриобретение(Реализация, Настройки)

	ДанныеЗаполнения = ДанныеЗаполненияПриобретения(Настройки);
	СсылкаПриобретение = РанееСозданноеПриобретение(Реализация.Ссылка, Настройки.ОрганизацияПокупатель);

	Если ЗначениеЗаполнено(СсылкаПриобретение) Тогда
		Приобретение = СсылкаПриобретение.ПолучитьОбъект();
	Иначе
		Приобретение = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
		Приобретение.Дата = Реализация.Дата;
		Приобретение.Заполнить(ДанныеЗаполнения);
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Приобретение, ДанныеЗаполнения);
	Приобретение.Дата            = Реализация.Дата;
	Приобретение.Валюта          = Реализация.Валюта;
	Приобретение.ЦенаВключаетНДС = Реализация.ЦенаВключаетНДС;
	Приобретение.Комментарий     = СтрШаблон("%1 (%2)", МаркерПриобретения(Реализация.Ссылка), Реализация.Ссылка);
	// При перезаполнении виды запасов должны заново определиться типовым кодом при проведении.
	УстановитьРеквизитЕслиЕсть(Приобретение, "ВидыЗапасовУказаныВручную", Ложь);

	// Входящий документ поставщика = реализация организации-продавца.
	УстановитьРеквизитЕслиЕсть(Приобретение, "НомерВходящегоДокумента", НомерНаПечать(Реализация.Номер));
	УстановитьРеквизитЕслиЕсть(Приобретение, "ДатаВходящегоДокумента",  Реализация.Дата);

	// Цены и суммы переносятся без пересчета - они должны совпасть с реализацией и счетом-фактурой продавца.
	Приобретение.Товары.Очистить();
	Для Каждого СтрокаРеализации Из Реализация.Товары Цикл
		СтрокаТоваров = Приобретение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаРеализации,
			"Номенклатура, Характеристика, Серия, Упаковка, КоличествоУпаковок, Количество,
			|Цена, Сумма, СтавкаНДС, СуммаНДС, СуммаСНДС");
		СтрокаТоваров.Склад = Настройки.СкладПоступления;
	КонецЦикла;

	ЗаполнитьСтатусыУказанияСерий(Приобретение, Документы.ПриобретениеТоваровУслуг);

	Возврат Приобретение;

КонецФункции

// Счет-фактура заполняется типовой обработкой заполнения по документу-основанию.
Функция ЗаполнитьСчетФактуру(ИмяДокумента, Основание, ДатаДокумента)

	СсылкаСчетФактура = СчетФактураПоОснованию(ИмяДокумента, Основание);

	Если ЗначениеЗаполнено(СсылкаСчетФактура) Тогда
		СчетФактура = СсылкаСчетФактура.ПолучитьОбъект();
		СчетФактура.ДокументыОснования.Очистить();
	Иначе
		СчетФактура = Документы[ИмяДокумента].СоздатьДокумент();
		СчетФактура.Дата = ДатаДокумента;
	КонецЕсли;

	СчетФактура.Заполнить(Основание);
	СчетФактура.Дата = ДатаДокумента;

	Возврат СчетФактура;

КонецФункции

Процедура ПометитьЦепочкуНаУдаление(СсылкаРеализация)

	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаРеализация, "Организация");

	НачатьТранзакцию();
	Попытка
		Приобретения = РанееСозданныеПриобретения(СсылкаРеализация);
		Для Каждого СсылкаПриобретение Из Приобретения Цикл
			ПометитьНаУдаление(СчетФактураПоОснованию("СчетФактураПолученный", СсылкаПриобретение));
			ПометитьНаУдаление(СсылкаПриобретение);
		КонецЦикла;
		ПометитьНаУдаление(СчетФактураПоОснованию("СчетФактураВыданный", СсылкаРеализация));
		ПометитьНаУдаление(СсылкаРеализация);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация,
		СсылкаРеализация.Метаданные(), СсылкаРеализация,
		СтрШаблон(НСтр("ru = 'Выпуска по складу больше нет, документы помечены на удаление (%1)'"), Организация));

КонецПроцедуры

Процедура ПометитьНаУдаление(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ДокументОбъект.УстановитьПометкуУдаления(Истина);

КонецПроцедуры

