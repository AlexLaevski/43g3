Процедура ПроверитьНастройки(Настройки)

	Обязательные = СтрРазделить("ОрганизацияПродавец, ПартнерПокупатель, КонтрагентПокупатель, ВидЦены,
		|ОрганизацияПокупатель, ПартнерПоставщик, КонтрагентПоставщик, СкладПоступления", "," + Символы.ПС, Ложь);

	НеЗаполнены = Новый Массив;
	Для Каждого ИмяЭлемента Из Обязательные Цикл
		ИмяНастройки = СокрЛП(ИмяЭлемента);
		Значение = Неопределено;
		Если Не Настройки.Свойство(ИмяНастройки, Значение) Или Не ЗначениеЗаполнено(Значение) Тогда
			НеЗаполнены.Добавить(ИмяНастройки);
		КонецЕсли;
	КонецЦикла;

	Если НеЗаполнены.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не заполнены настройки продажи выпуска: %1'"),
			СтрСоединить(НеЗаполнены, ", "));
	КонецЕсли;

	Если Настройки.ОрганизацияПродавец = Настройки.ОрганизацияПокупатель Тогда
		ВызватьИсключение НСтр("ru = 'Организация-продавец и организация-покупатель должны различаться'");
	КонецЕсли;

КонецПроцедуры

Процедура ЗарегистрироватьОшибку(Результат, Контекст, Информация)

	// Сообщения типовой проверки заполнения при проведении объясняют причину лучше текста исключения.
	Тексты = Новый Массив;
	Тексты.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	ТекстОшибки = Контекст + ":" + Символы.ПС + СтрСоединить(Тексты, Символы.ПС);
	Результат.Ошибки.Добавить(ТекстОшибки);

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
		ТекстОшибки + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));

	ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);

КонецПроцедуры

Функция МаркерДокумента()
	Возврат "#АвтоПродажаВыпуска#";
КонецФункции

// Приобретение связывается со своей реализацией через уникальный идентификатор в комментарии.
Функция МаркерПриобретения(СсылкаРеализация)
	Возврат МаркерДокумента() + " " + Строка(СсылкаРеализация.УникальныйИдентификатор());
КонецФункции

Функция ИмяСобытияЖурнала()
	Возврат НСтр("ru = 'Продажа выпуска между организациями'", ОбщегоНазначения.КодОсновногоЯзыка());
КонецФункции

Функция КлючНастроек()
	Возврат "АвтоПродажаВыпускаМеждуОрганизациями";
КонецФункции

// Настройки общие для всех пользователей: регламентное задание может выполняться от имени другого пользователя.
Функция ИмяПользователяНастроек()
	Возврат "АвтоПродажаВыпускаМеждуОрганизациями";
КонецФункции

#КонецОбласти

#КонецОбласти
